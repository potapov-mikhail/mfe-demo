{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "mf-host": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/mf-host",
      "sourceRoot": "projects/mf-host/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/mf-host/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mf-host/public",
                "output": "."
              }
            ],
            "styles": [
              "projects/host-ui/styles.css"
            ],
            "outputPath": "dist/mf-host",
            "main": "projects/mf-host/src/main.ts",
            "index": "projects/mf-host/src/index.html",
            "extraWebpackConfig": "projects/mf-host/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "projects/mf-host/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mf-host:build:production",
              "extraWebpackConfig": "projects/mf-host/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "mf-host:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "publicHost": "http://localhost:4200",
            "extraWebpackConfig": "projects/mf-host/webpack.config.js"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/mf-host/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/mf-host/public"
              }
            ],
            "styles": [
              "projects/host-ui/styles.css"
            ]
          }
        }
      }
    },
