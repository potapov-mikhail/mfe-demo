{
  "name": "mfe-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others -n remote,mf-host,plain-host npm:start:remote npm:start:mf-host npm:start:plain-host",
    "start:remote": "ng serve remote --port 4201",
    "start:mf-host": "ng serve mf-host --port 4200",
    "start:plain-host": "ng serve plain-host --port 4202",
    "build": "ng build remote && ng build mf-host && ng build plain-host",
    "serve:dist": "node scripts/serve-dist.cjs",
    "test": "playwright test",
    "test:e2e": "playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/router": "20.3.33",
    "@module-federation/enhanced": "2.9.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "20.0.0",
    "@angular-devkit/build-angular": "20.3.37",
    "@angular/build": "20.3.37",
    "@angular/cli": "20.3.37",
    "@angular/compiler-cli": "20.3.33",
    "@playwright/test": "1.63.0",
    "@types/jasmine": "5.1.15",
    "concurrently": "9.2.4",
    "jasmine-core": "5.9.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "ngx-build-plus": "20.0.0",
    "typescript": "5.9.3"
  }
}
